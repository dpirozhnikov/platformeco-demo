{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "title": "statused_model",
  "properties": {
    "documentNumber": {
      "type": "string",
      "description": "Номер документа"
    },
    "documentDate": {
      "description": "Дата документа",
      "type": "string",
      "format": "date"
    },
    "documentSum": {
      "description": "Сумма документа",
      "type": "number",
      "minimum": 0
    },
    "chargeAccount": {
      "description": "Счет списания",
      "type": "string",
      "pattern": ".*-1$"
    },
    "depositAccount": {
      "description": "Счет зачисления",
      "type": "string",
      "pattern": ".*-1$"
    },
    "description": {
      "description": "Описание перевода",
      "type": "string"
    },
    "status": {
      "description": "Статус модели",
      "type": "string",
      "enum": [
        "Новый (сохранен без ошибок)",
        "Ошибка контроля (сохранен с ошибками контролей)",
        "Доставлен (передан для дальнейшей обработки)",
        "Выгружен (выгружен на бэке)"
      ]
    }
  },
  "required": [
    "documentNumber",
    "documentDate",
    "documentSum",
    "chargeAccount",
    "depositAccount",
    "description",
    "status"
  ]
}
