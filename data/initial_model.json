{
  "title": "initial_model",
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "properties": {
    "documentNumber": {
      "type": "string",
      "description": "Номер документа"
    },
    "documentDate": {
      "description": "Дата документа",
      "type": "string",
      "format": "date"
    },
    "documentSum": {
      "description": "Сумма документа",
      "type": "number",
      "minimum": 0
    },
    "chargeAccount": {
      "description": "Счет списания",
      "type": "string",
      "pattern": ".*-1$"
    },
    "depositAccount": {
      "description": "Счет зачисления",
      "type": "string",
      "pattern": ".*-1$"
    },
    "description": {
      "description": "Описание перевода",
      "type": "string"
    }
  },
  "required": [
    "documentNumber",
    "documentDate",
    "documentSum",
    "chargeAccount",
    "depositAccount",
    "description"
  ],
  "default": {
    "documentNumber": "DOC123456",
    "documentDate": "2024-06-24",
    "documentSum": 9876.5432,
    "chargeAccount": "123-1",
    "depositAccount": "456-1",
    "description": "Payment for services rendered"
  }
}